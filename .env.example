# ==========================================
# IPL Auction Online - Environment Variables
# ==========================================

# -----------------
# Server Config
# -----------------
PORT=5001
JWT_SECRET=your_jwt_secret_key_here

# -----------------
# Database Config
# -----------------
# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ipl?retryWrites=true&w=majority

# -----------------
# AI & LLM Service Keys
# -----------------
# Groq API (Primary fast inference for commentary & evaluation)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Backup / multimodal evaluation)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# HuggingFace API (Alternative model inference)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
HUGGINGFACE_MODEL=google/gemma-4-31B-it

# -----------------
# Client Config (Vite)
# -----------------
VITE_API_URL=http://localhost:5001
